rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true && (
          request.auth.token.email == 'subhasishdas1001@gmail.com' ||
          request.auth.token.admin == true ||
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        );
    }

    function isSupportedImageType() {
      return request.resource != null &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') &&
        request.resource.size <= 15 * 1024 * 1024;
    }

    function isSupportedVideoType() {
      return request.resource != null &&
        request.resource.contentType.matches('video/mp4') &&
        request.resource.size <= 100 * 1024 * 1024;
    }

    function isAllowedMediaUpload() {
      return isSupportedImageType() || isSupportedVideoType();
    }

    // VYNOOX Storefront & Admin Media Library Storage
    // Categories: hero_desktop, hero_mobile, ugc_video, product_media, general
    match /vynoox_media/{mediaCategory}/{fileName} {
      // Customers and storefront visitors can view/stream published hero & UGC media
      allow get, list: if true;

      // Only verified administrators can upload or replace validated JPG/JPEG/PNG/WEBP/MP4 files
      allow create, update: if isVerifiedAdmin() &&
        mediaCategory in ['hero_desktop', 'hero_mobile', 'ugc_video', 'product_media', 'general'] &&
        fileName.size() >= 3 &&
        fileName.size() <= 180 &&
        isAllowedMediaUpload();

      // Only verified administrators can delete media files
      allow delete: if isVerifiedAdmin();
    }
  }
}
